{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"lint": {
			"inputs": [
				"src/**",
				"!src/generated/**",
				"test/**",
				"tests/**",
				"examples/**",
				"*.ts",
				"*.tsx",
				"*.js",
				"*.mjs",
				"*.json"
			]
		},
		"test": {
			"dependsOn": ["^build", "build"],
			"inputs": [
				"src/**",
				"test/**",
				"tests/**",
				"test-setup/**",
				"__tests__/**",
				"*.ts",
				"*.tsx",
				"move/*/Move.toml",
				"move/*/sources/**",
				"move/vendor/*/*/Move.toml",
				"move/vendor/*/*/sources/**",
				"!src/generated/**",
				"vitest.config.*",
				"tsconfig.json"
			]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": [
				"src/**",
				"test/**",
				"tests/**",
				"__tests__/**",
				"e2e/**",
				"move/*/Move.toml",
				"move/*/sources/**",
				"move/vendor/*/*/Move.toml",
				"move/vendor/*/*/sources/**",
				"!src/generated/**",
				"*.ts",
				"*.tsx",
				"tsconfig.json",
				"tsconfig.*.json"
			]
		},
		"test:e2e": {
			"dependsOn": ["^build", "build"],
			"inputs": [
				"src/**",
				"test/**",
				"tests/**",
				"__tests__/**",
				"e2e/**",
				"move/*/Move.toml",
				"move/*/sources/**",
				"move/vendor/*/*/Move.toml",
				"move/vendor/*/*/sources/**",
				"!src/generated/**",
				"*.ts",
				"*.tsx",
				"devstack.config.*",
				"playwright.config.*",
				"vitest.config.*",
				"tsconfig.json"
			],
			"cache": false
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build", "build:docs"],
			"inputs": [
				"src/**",
				"bin/**",
				"scripts/**",
				"templates/**",
				"*.ts",
				"*.mjs",
				"move/*/Move.toml",
				"move/*/sources/**",
				"move/vendor/*/*/Move.toml",
				"move/vendor/*/*/sources/**",
				"!src/generated/**",
				"tsconfig.json",
				"tsdown.config.ts",
				"package.json"
			],
			"outputs": ["build/**", "dist/**", "docs/**"]
		},
		"build:docs": {
			"inputs": ["../docs/content/**", "../docs/scripts/**"],
			"outputs": ["docs/**"]
		},
		"@mysten-incubation/docs#build:docs": {
			"inputs": ["content/**", "scripts/**"],
			"outputs": ["dist/**"]
		},
		"@mysten-incubation/docs#build": {
			"dependsOn": ["^build", "build:docs"],
			"inputs": [
				"content/**",
				"app/**",
				"components/**",
				"lib/**",
				"examples/**",
				"scripts/**",
				"*.ts",
				"*.mjs",
				"tsconfig.json",
				"next.config.mjs",
				"source.config.ts",
				"package.json"
			],
			"outputs": [".next/**", "!.next/cache/**", "public/**", "dist/**"]
		}
	}
}
