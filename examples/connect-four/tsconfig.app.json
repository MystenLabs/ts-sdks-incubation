{
	"extends": "@mysten-incubation/tsconfig/react.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@generated/*": ["./src/generated/*"],
			"@devstack-dev/*": ["./.devstack/stacks/connect-four/generated-extras/*"]
		}
	},
	"include": [
		"src/**/*",
		"deployments/**/*",
		".devstack/stacks/connect-four/generated-extras/**/*"
	],
	"exclude": ["dist", "node_modules", "tests"]
}
