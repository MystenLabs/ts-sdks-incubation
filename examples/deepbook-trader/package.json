{
	"name": "@mysten-incubation/deepbook-trader",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "DEVSTACK_APP=deepbook-trader node ../../packages/devstack/dist/cli/main.mjs codegen",
		"devstack:apply": "DEVSTACK_APP=deepbook-trader node ../../packages/devstack/dist/cli/main.mjs apply",
		"apply": "pnpm run devstack:apply",
		"dev": "DEVSTACK_APP=deepbook-trader node ../../packages/devstack/dist/cli/main.mjs up",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:e2e": "DEVSTACK_APP=deepbook-trader DEVSTACK_STACK=e2e DEVSTACK_AUTO_APPROVE=1 playwright test",
		"clean": "rm -rf dist .turbo node_modules/.tmp"
	},
	"dependencies": {
		"@mysten-incubation/dev-wallet": "workspace:*",
		"@mysten-incubation/devstack": "workspace:*",
		"@mysten/dapp-kit-core": "catalog:",
		"@mysten/dapp-kit-react": "catalog:",
		"@mysten/deepbook-v3": "catalog:",
		"@mysten/sui": "catalog:",
		"@mysten/wallet-standard": "catalog:",
		"@tanstack/react-query": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "workspace:*",
		"@playwright/test": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
