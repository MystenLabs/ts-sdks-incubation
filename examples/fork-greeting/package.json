{
	"name": "@mysten-incubation/example-fork-greeting",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "devstack up",
		"build": "if [ -f src/generated/dapp-kit-config.ts ]; then tsc -b && vite build; else echo 'skipping build: no src/generated/ — run devstack apply first'; fi",
		"preview": "vite preview",
		"typecheck": "if [ -f src/generated/dapp-kit-config.ts ]; then tsc -b --noEmit; else echo \"skipping typecheck: no src/generated/ — run devstack apply first\"; fi",
		"test": "DEVSTACK_STACK=test vitest run",
		"test:watch": "vitest",
		"test:e2e": "DEVSTACK_STACK=test playwright test",
		"clean": "rm -rf dist .turbo node_modules/.tmp",
		"apply": "devstack apply",
		"stack": "devstack stack"
	},
	"dependencies": {
		"@mysten-incubation/dev-wallet": "workspace:*",
		"@mysten-incubation/devstack": "workspace:*",
		"@mysten/dapp-kit-core": "catalog:",
		"@mysten/dapp-kit-react": "catalog:",
		"@mysten/sui": "catalog:",
		"@mysten/wallet-standard": "catalog:",
		"@tanstack/react-query": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "workspace:*",
		"@playwright/test": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
