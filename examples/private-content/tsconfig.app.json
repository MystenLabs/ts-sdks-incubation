{
	"extends": "@mysten-incubation/tsconfig/react.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@generated/*": ["./src/generated/*"],
			"@devstack-dev/*": ["./.devstack/stacks/private-content/generated-extras/*"]
		}
	},
	"include": ["src/**/*", ".devstack/stacks/private-content/generated-extras/**/*"],
	"exclude": ["dist", "node_modules", "e2e", "**/*.test.ts", "**/*.test.tsx"]
}
