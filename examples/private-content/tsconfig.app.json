{
	"extends": "@mysten-incubation/tsconfig/react.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@generated/*": ["./src/generated/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules", "e2e", ".devstack", "**/*.test.ts", "**/*.test.tsx"]
}
