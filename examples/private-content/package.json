{
	"name": "@mysten-incubation/private-content",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"devstack:build": "pnpm --filter @mysten-incubation/devstack build",
		"apply": "pnpm run devstack:build && DEVSTACK_APP=private-content node ../../packages/devstack/dist/cli/main.mjs apply",
		"typecheck": "tsc -b --noEmit",
		"test": "pnpm run typecheck",
		"clean": "rm -rf dist .turbo node_modules/.tmp"
	},
	"dependencies": {
		"@mysten-incubation/devstack": "workspace:*",
		"@mysten/seal": "catalog:",
		"@mysten/sui": "catalog:",
		"@mysten/walrus": "^1.1.7",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "workspace:*",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
