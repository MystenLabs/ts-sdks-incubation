{
	"name": "@mysten-incubation/private-content",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "devstack up",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"test": "DEVSTACK_STACK=test vitest run",
