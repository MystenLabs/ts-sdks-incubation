		"@mysten/seal": "catalog:",
		"@mysten/sui": "catalog:",
		"@mysten/wallet-standard": "catalog:",
		"@mysten/walrus": "^1.1.7",
		"@mysten/walrus-wasm": "^0.2.0",
		"@tanstack/react-query": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "workspace:*",
		"@playwright/test": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
