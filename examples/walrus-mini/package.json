{
	"name": "@mysten-incubation/example-walrus-mini",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"devstack:build": "pnpm --filter @mysten-incubation/devstack build",
		"apply": "pnpm run devstack:build && DEVSTACK_APP=walrus-mini node ../../packages/devstack/dist/cli/main.mjs apply",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run typecheck",
		"clean": "rm -rf .turbo node_modules/.tmp"
	},
	"dependencies": {
		"@mysten-incubation/devstack": "workspace:*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
