{
	"name": "@mysten-incubation/example-effect-app-rewrite",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"devstack:build": "pnpm --filter @mysten-incubation/devstack-rewrite build",
		"apply": "pnpm run devstack:build && DEVSTACK_APP=effect-app-rewrite devstack apply",
		"start": "tsx src/main.ts",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run typecheck",
		"clean": "rm -rf dist .turbo node_modules/.tmp"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@mysten-incubation/devstack-rewrite": "workspace:*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
