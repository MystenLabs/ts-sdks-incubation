{
	"name": "@mysten-incubation/example-fork-greeting-rewrite",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"devstack:build": "pnpm --filter @mysten-incubation/devstack-rewrite build",
		"apply": "pnpm run devstack:build && DEVSTACK_APP=fork-greeting-rewrite devstack apply",
		"typecheck": "tsc -b --noEmit",
		"test": "pnpm run typecheck",
		"clean": "rm -rf .turbo node_modules/.tmp"
	},
	"dependencies": {
		"@mysten-incubation/devstack-rewrite": "workspace:*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
