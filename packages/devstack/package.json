{
	"name": "@mysten-incubation/devstack",
	"version": "0.0.0",
	"description": "Hermetic local Sui development stack — composes localnet + Walrus + Seal + DeepBook + your Move packages as Effect Layers, with a TUI runner and the same primitives reachable as embeddable services.",
	"keywords": ["sui", "devstack", "effect", "developer-experience"],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MystenLabs/ts-sdks-incubation.git",
		"directory": "packages/devstack"
	},
	"homepage": "https://github.com/MystenLabs/ts-sdks-incubation/tree/main/packages/devstack#readme",
	"bugs": {
		"url": "https://github.com/MystenLabs/ts-sdks-incubation/issues"
	},
	"private": true,
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"devstack": "./dist/cli/main.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./dapp-kit": {
			"types": "./dist/dapp-kit/index.d.mts",
			"import": "./dist/dapp-kit/index.mjs"
		},
		"./vitest": {
			"types": "./dist/vitest/index.d.mts",
			"import": "./dist/vitest/index.mjs"
		},
		"./playwright": {
			"types": "./dist/playwright/index.d.mts",
			"import": "./dist/playwright/index.mjs"
		},
		"./plugin-author": {
			"types": "./dist/plugin-author/index.d.mts",
			"import": "./dist/plugin-author/index.mjs"
		}
	},
	"sideEffects": false,
	"files": ["dist", "src", "README.md", "AGENTS.md", "LICENSE"],
	"scripts": {
		"build": "tsdown && pnpm build:dts-subpaths",
		"build:dts-subpaths": "tsc -p tsconfig.subpaths.json && node --experimental-strip-types scripts/finalize-subpath-dts.ts",
		"build:watch": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"effect": "catalog:",
		"@effect/platform-node": "catalog:",
		"@mysten/codegen": "catalog:",
		"@mysten/sui": "catalog:",
		"ink": "^7.0.0",
		"react": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@mysten-incubation/dev-wallet": "workspace:*",
		"@mysten-incubation/devstack-wallet-panels": "workspace:*",
		"@mysten-incubation/tsconfig": "workspace:*",
		"@mysten/dapp-kit-core": "catalog:",
		"@mysten/dapp-kit-react": "catalog:",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"ink-testing-library": "^4.0.0",
		"tsdown": "^0.21.10",
		"typescript": "catalog:",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"@mysten-incubation/dev-wallet": "workspace:*",
		"@mysten-incubation/devstack-wallet-panels": "workspace:*",
		"@mysten/dapp-kit-core": "catalog:",
		"@mysten/dapp-kit-react": "catalog:",
		"@mysten/sui": "catalog:",
		"@playwright/test": "catalog:"
	},
	"peerDependenciesMeta": {
		"@mysten-incubation/dev-wallet": {
			"optional": true
		},
		"@mysten-incubation/devstack-wallet-panels": {
			"optional": true
		},
		"@mysten/dapp-kit-core": {
			"optional": true
		},
		"@mysten/dapp-kit-react": {
			"optional": true
		},
		"@playwright/test": {
			"optional": true
		}
	}
}
