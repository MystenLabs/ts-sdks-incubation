{
	"name": "@mysten-incubation/devstack",
	"version": "0.3.0",
	"description": "Next-generation Sui devstack package.",
	"keywords": [
		"sui",
		"devstack",
		"effect",
		"developer-experience"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/MystenLabs/ts-sdks-incubation",
		"directory": "packages/devstack"
	},
	"homepage": "https://github.com/MystenLabs/ts-sdks-incubation/tree/main/packages/devstack#readme",
	"bugs": {
		"url": "https://github.com/MystenLabs/ts-sdks-incubation/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"devstack": "./dist/cli/main.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./vitest": {
			"types": "./dist/build-integrations/vitest/index.d.mts",
			"import": "./dist/build-integrations/vitest/index.mjs"
		},
		"./vitest/setup": {
			"types": "./dist/build-integrations/vitest/setup.d.mts",
			"import": "./dist/build-integrations/vitest/setup.mjs"
		},
		"./vitest/global-setup": {
			"types": "./dist/build-integrations/vitest/global-setup.d.mts",
			"import": "./dist/build-integrations/vitest/global-setup.mjs",
			"default": "./dist/build-integrations/vitest/global-setup.mjs"
		},
		"./playwright": {
			"types": "./dist/build-integrations/playwright/index.d.mts",
			"import": "./dist/build-integrations/playwright/index.mjs"
		},
		"./vite": {
			"types": "./dist/build-integrations/vite/index.d.mts",
			"import": "./dist/build-integrations/vite/index.mjs"
		},
		"./dapp-kit": {
			"types": "./dist/build-integrations/dapp-kit/index.d.mts",
			"import": "./dist/build-integrations/dapp-kit/index.mjs"
		},
		"./playwright/global-setup": {
			"types": "./dist/build-integrations/playwright/global-setup.d.mts",
			"import": "./dist/build-integrations/playwright/global-setup.mjs",
			"default": "./dist/build-integrations/playwright/global-setup.mjs"
		},
		"./runtime": {
			"types": "./dist/build-integrations/runtime/index.d.mts",
			"import": "./dist/build-integrations/runtime/index.mjs"
		}
	},
	"sideEffects": true,
	"files": [
		"dist",
		"images",
		"dashboard-ui",
		"!dist/samples",
		"!dist/node_modules"
	],
	"scripts": {
		"build": "pnpm run build:dashboard-ui && tsdown",
		"build:dashboard-ui": "node scripts/build-dashboard-ui.mjs",
		"smoke:pack-consumer": "node scripts/packed-consumer-typecheck.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "DEVSTACK_RUN_E2E=1 vitest run"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@mysten/codegen": "catalog:",
		"@mysten/deepbook-v3": "catalog:",
		"@mysten/sui": "catalog:",
		"@pothos/core": "catalog:",
		"@pothos/plugin-relay": "catalog:",
		"@pothos/plugin-simple-objects": "catalog:",
		"@pothos/plugin-with-input": "catalog:",
		"@stricli/core": "catalog:",
		"effect": "catalog:",
		"graphql": "catalog:",
		"graphql-yoga": "catalog:",
		"ink": "catalog:",
		"react": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@mysten-incubation/tsconfig": "workspace:*",
		"@mysten/seal": "catalog:",
		"@mysten/walrus": "^1.2.0",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"ink-testing-library": "^4.0.0",
		"tsdown": "^0.22.2",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"vitest": "^4.1.6"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	}
}
