{
	"name": "@mysten-incubation/devstack",
	"version": "0.0.0",
	"description": "Next-generation Sui devstack package.",
	"keywords": ["sui", "devstack", "effect", "developer-experience"],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MystenLabs/ts-sdks-incubation.git",
		"directory": "packages/devstack"
	},
	"homepage": "https://github.com/MystenLabs/ts-sdks-incubation/tree/main/packages/devstack#readme",
	"bugs": {
		"url": "https://github.com/MystenLabs/ts-sdks-incubation/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"devstack": "./dist/cli/main.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./contracts": {
			"types": "./dist/contracts/index.d.mts",
			"import": "./dist/contracts/index.mjs"
		},
		"./substrate": {
			"types": "./dist/substrate/index.d.mts",
			"import": "./dist/substrate/index.mjs"
		},
		"./vite": {
			"types": "./dist/build-integrations/vite/index.d.mts",
			"import": "./dist/build-integrations/vite/index.mjs"
		},
		"./vitest": {
			"types": "./dist/build-integrations/vitest/index.d.mts",
			"import": "./dist/build-integrations/vitest/index.mjs"
		},
		"./vitest/setup": {
			"types": "./dist/build-integrations/vitest/setup.d.mts",
			"import": "./dist/build-integrations/vitest/setup.mjs"
		},
		"./playwright": {
			"types": "./dist/build-integrations/playwright/index.d.mts",
			"import": "./dist/build-integrations/playwright/index.mjs"
		},
		"./browser": {
			"types": "./dist/build-integrations/browser/index.d.mts",
			"import": "./dist/build-integrations/browser/index.mjs"
		},
		"./browser/setup": {
			"types": "./dist/build-integrations/browser/setup.d.mts",
			"import": "./dist/build-integrations/browser/setup.mjs"
		},
		"./runtime": {
			"types": "./dist/build-integrations/runtime/index.d.mts",
			"import": "./dist/build-integrations/runtime/index.mjs"
		}
	},
	"sideEffects": false,
	"files": [
		"src",
		"dist",
		"images",
		"!src/generated",
		"!src/samples",
		"!dist/samples",
		"!dist/node_modules"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "DEVSTACK_RUN_E2E=1 vitest run"
	},
	"dependencies": {
		"effect": "catalog:",
		"@effect/platform-node": "catalog:",
		"@mysten/codegen": "catalog:",
		"@mysten/sui": "catalog:",
		"ink": "^7.0.0",
		"react": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@mysten-incubation/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"ink-testing-library": "^4.0.0",
		"tsdown": "^0.21.10",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "^4.1.6"
	},
	"peerDependencies": {
		"vite": "catalog:",
		"vitest": "^4.1.6"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	}
}
