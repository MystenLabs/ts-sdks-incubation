{
	"name": "@mysten-incubation/devstack",
	"version": "1.0.0",
	"description": "Declarative reconciler + plugin harness for fully-seeded Sui local development. Brings up sui-localnet (+ optional walrus, seal), publishes Move packages, runs codegen, and writes a typed manifest the frontend consumes.",
	"keywords": [
		"sui",
		"move",
		"localnet",
		"developer-experience",
		"walrus",
		"seal",
		"docker"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mysten-incubation/devstack.git"
	},
	"homepage": "https://github.com/mysten-incubation/devstack#readme",
	"bugs": {
		"url": "https://github.com/mysten-incubation/devstack/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./cli": {
			"types": "./dist/cli.d.mts",
			"import": "./dist/cli.mjs"
		},
		"./helpers": {
			"types": "./dist/helpers.d.mts",
			"import": "./dist/helpers.mjs"
		},
		"./playwright": {
			"types": "./dist/playwright/index.d.mts",
			"import": "./dist/playwright/index.mjs"
		},
		"./react": {
			"types": "./dist/react/index.d.mts",
			"import": "./dist/react/index.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"import": "./dist/runtime.mjs"
		},
		"./vite": {
			"types": "./dist/vite/plugin.d.mts",
			"import": "./dist/vite/plugin.mjs"
		},
		"./vitest": {
			"types": "./dist/vitest/index.d.mts",
			"import": "./dist/vitest/index.mjs"
		},
		"./vitest/runtime": {
			"types": "./dist/vitest/runtime.d.mts",
			"import": "./dist/vitest/runtime.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"devstack": "./dist/cli/index.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@mysten/codegen": "^0.10.4",
		"@mysten/sui": "catalog:",
		"@mysten/walrus": "^1.1.4",
		"chokidar": "^4.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@mysten/dapp-kit-core": "catalog:",
		"@mysten/dapp-kit-react": "catalog:",
		"@playwright/test": "catalog:",
		"@tanstack/react-query": "catalog:",
		"@types/node": "^22.10.0",
		"@types/react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "0.20.0-beta.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@mysten/dapp-kit-core": "catalog:",
		"@mysten/dapp-kit-react": "catalog:",
		"@playwright/test": "catalog:",
		"@tanstack/react-query": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependenciesMeta": {
		"@mysten/dapp-kit-core": {
			"optional": true
		},
		"@mysten/dapp-kit-react": {
			"optional": true
		},
		"@playwright/test": {
			"optional": true
		},
		"@tanstack/react-query": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	}
}
