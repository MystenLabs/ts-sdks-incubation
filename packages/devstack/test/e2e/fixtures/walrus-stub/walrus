#!/bin/sh
# Walrus binary stub. Dispatches on argv[1] between two modes:
#
#   - `deploy ...`  → emit parseable deploy output + per-node config
#                      files; exit 0.
#   - `aggregator` / `publisher` → bind HTTP on WALRUS_CONTAINER_PORT
#                      (default 9185), answer `/status`, and stay alive.
#   - any other mode → bind HTTPS on WALRUS_CONTAINER_PORT (default 9185),
#                      answer `/v1/health` with an Active nodeStatus, and
#                      stay alive. This models storage-node readiness
#                      without implementing Walrus.
#
# The real `walrus` binary uses subcommands; the plugin's argv path
# always starts with `deploy` for the one-shot. Anything else is
# treated as a long-lived listener. The stub is the wrapper-image equivalent,
# so aggregator / publisher service containers also land here.

set -eu

mint_object_id() {
	# 32 bytes hex, lowercase. /dev/urandom + busybox `od` gives a
	# deterministic-ish but per-invocation fresh id.
	od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
}

mode="${1:-listen}"

case "$mode" in
	deploy)
		shift
		# Walk argv to find --output-dir, --committee-size, and the
		# public-hosts / listening-ips CSVs. We do this manually with
		# busybox `getopts` is too restrictive for `--long` flags.
		out_dir="/opt/walrus/outputs"
		committee_size=1
		while [ $# -gt 0 ]; do
			case "$1" in
				--output-dir) out_dir="$2"; shift 2 ;;
				--committee-size) committee_size="$2"; shift 2 ;;
				--shards) shift 2 ;;
				--epoch-duration) shift 2 ;;
				--sui-rpc-url) shift 2 ;;
				--faucet-url) shift 2 ;;
				--public-hosts) shift 2 ;;
				--listening-ips) shift 2 ;;
				*) shift ;;
			esac
		done

		mkdir -p "$out_dir"

		# Mint a per-deploy package id, but use an existing Sui system
		# package object for the system/staking ids. The e2e stub does
		# not publish real Walrus objects; using an existing object lets
		# the ArtifactPublisher verify cache hits on warm restart while
		# still exercising the on-chain probe path.
		pkg_id="0x$(mint_object_id)"
		sys_id="0x2"
		staking_id="0x2"
		upgrade_id="0x$(mint_object_id)"
		treasury_id="0x$(mint_object_id)"

		# Emit per-node config files so the storage-node read-only
		# bind-mount of /opt/walrus/outputs has something to find.
		# (The real walrus deploy emits `dryrun-node-<i>.yaml` +
		# `dryrun-node-<i>-sui.yaml` + `dryrun-node-<i>.keystore`
		# per committee member, plus funded `sui_client` / Walrus client
		# config files for publisher/aggregator.)
		printf 'system_object: 0x2\nstaking_object: 0x2\nwallet_config: %s/sui_client.yaml\n' "$out_dir" > "$out_dir/client_config.yaml"
		printf 'active_env: localnet\nenvs:\n  - alias: localnet\n    rpc: http://host.docker.internal:9123\nkeystore:\n  File: %s/sui_client.keystore\n' "$out_dir" > "$out_dir/sui_client.yaml"
		printf 'stub-client-keystore\n' > "$out_dir/sui_client.keystore"
		i=0
		while [ "$i" -lt "$committee_size" ]; do
			printf 'name: dryrun-node-%s\n' "$i" > "$out_dir/dryrun-node-$i.yaml"
			printf 'sui: localnet\n' > "$out_dir/dryrun-node-$i-sui.yaml"
			printf 'stub-keystore-%s\n' "$i" > "$out_dir/dryrun-node-$i.keystore"
			i=$((i + 1))
		done

		# Emit the deploy summary both on stdout and in the cache file
		# shape the real deploy writes.
		cat > "$out_dir/deploy" <<EOF
walrus_package_id: $pkg_id
system_object: $sys_id
staking_object: $staking_id
upgrade_manager_object: $upgrade_id
treasury_object: $treasury_id
exchange_object: None
EOF
		cat "$out_dir/deploy"
		exit 0
		;;
	*)
		# Long-lived service mode. Storage nodes keep Walrus' TLS shape;
		# publisher / aggregator daemons expose plain HTTP.
		port="${WALRUS_CONTAINER_PORT:-9185}"
		root="/tmp/walrus-stub-http"
		mkdir -p "$root/v1"
		printf '{"nodeStatus":"Active"}\n' > "$root/v1/health"
		printf '{"status":"OK"}\n' > "$root/status"
		case "$mode" in
			aggregator|publisher)
				exec httpd -f -p "$port" -h "$root"
				;;
			*)
				cert="$root/cert.pem"
				key="$root/key.pem"
				openssl req -x509 -newkey rsa:2048 -nodes \
					-keyout "$key" \
					-out "$cert" \
					-days 1 \
					-subj "/CN=walrus-stub.localhost" >/dev/null 2>&1
				cd "$root"
				exec openssl s_server -quiet -accept "$port" -cert "$cert" -key "$key" -WWW
				;;
		esac
		;;
esac
