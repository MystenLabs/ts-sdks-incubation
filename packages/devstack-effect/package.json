{
	"name": "@mysten-incubation/devstack-effect",
	"version": "0.0.0",
	"description": "Experimental Effect-based reimplementation of @mysten-incubation/devstack. Parallel spike, not a replacement.",
	"keywords": ["sui", "devstack", "effect", "developer-experience"],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MystenLabs/ts-sdks-incubation.git",
		"directory": "packages/devstack-effect"
	},
	"homepage": "https://github.com/MystenLabs/ts-sdks-incubation/tree/main/packages/devstack-effect#readme",
	"bugs": {
		"url": "https://github.com/MystenLabs/ts-sdks-incubation/issues"
	},
	"private": true,
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"sideEffects": false,
	"files": ["dist", "README.md", "AGENTS.md", "LICENSE"],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"effect": "catalog:",
		"@effect/platform-node": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@mysten-incubation/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.21.10",
		"typescript": "catalog:",
		"vitest": "^3.2.4"
	}
}
