{
	"name": "@mysten-incubation/apple-signer",
	"version": "0.0.1",
	"description": "Apple-platform Sui signer: Secure Enclave (device-bound, non-recoverable) and Keychain (UI-recoverable) modes, fronted by a universal Swift helper with one-Touch-ID-per-process UX",
	"license": "Apache-2.0",
	"author": "Mysten Labs <build@mystenlabs.com>",
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"engines": {
		"node": ">=22"
	},
	"os": [
		"darwin"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./recover": {
			"types": "./dist/recover.d.mts",
			"import": "./dist/recover.mjs"
		}
	},
	"files": [
		"CHANGELOG.md",
		"bin",
		"dist",
		"docs",
		"native/Package.swift",
		"native/Sources",
		"native/apple-signer.entitlements",
		"src"
	],
	"scripts": {
		"clean": "rm -rf tsconfig.tsbuildinfo ./dist ./docs ./native/.build ./bin",
		"build:docs": "tsx ../docs/scripts/build-docs.ts",
		"build:native": "bash scripts/build-universal.sh",
		"build": "rm -rf dist && pnpm run build:native && tsc --noEmit && tsdown",
		"prettier:check": "prettier -c --ignore-unknown .",
		"prettier:fix": "prettier -w --ignore-unknown .",
		"oxlint:check": "oxlint .",
		"oxlint:fix": "oxlint --fix",
		"lint": "pnpm run oxlint:check && pnpm run prettier:check",
		"lint:fix": "pnpm run oxlint:fix && pnpm run prettier:fix",
		"test": "vitest run --config vitest.config.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MystenLabs/ts-sdks-incubation.git"
	},
	"bugs": {
		"url": "https://github.com/MystenLabs/ts-sdks-incubation/issues"
	},
	"keywords": [
		"sui",
		"apple",
		"secure-enclave",
		"keychain",
		"signer",
		"biometric",
		"touch-id",
		"macos"
	],
	"homepage": "https://github.com/MystenLabs/ts-sdks-incubation/tree/main/packages/apple-signer#readme",
	"devDependencies": {
		"@mysten/signers": "^1.0.1",
		"@mysten/sui": "^2.9.1",
		"@types/node": "^25.0.8",
		"@types/node-forge": "^1.3.11",
		"typescript": "^5.9.3",
		"vitest": "^4.0.17"
	},
	"dependencies": {
		"@noble/curves": "^2.0.1",
		"@scure/bip39": "^2.0.1",
		"node-forge": "^1.4.0"
	},
	"peerDependencies": {
		"@mysten/signers": "^1.0.1",
		"@mysten/sui": "^2.9.1"
	}
}
