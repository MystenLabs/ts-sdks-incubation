{
	"name": "@mysten-incubation/devstack-next",
	"version": "1.0.0-rc.0",
	"description": "Layered redesign of @mysten-incubation/devstack — pure-logic engine, define/defineSchema factories, plugin packages.",
	"keywords": [
		"sui",
		"move",
		"localnet",
		"developer-experience",
		"walrus",
		"seal",
		"docker"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MystenLabs/ts-sdks-incubation.git",
		"directory": "packages/devstack-next"
	},
	"homepage": "https://github.com/MystenLabs/ts-sdks-incubation/tree/main/packages/devstack-next#readme",
	"bugs": {
		"url": "https://github.com/MystenLabs/ts-sdks-incubation/issues"
	},
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"devstack-next": "./dist/cli/main.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./helpers": {
			"types": "./dist/helpers/index.d.mts",
			"import": "./dist/helpers/index.mjs"
		},
		"./persistence": {
			"types": "./dist/persistence/index.d.mts",
			"import": "./dist/persistence/index.mjs"
		},
		"./playwright": {
			"types": "./dist/playwright/index.d.mts",
			"import": "./dist/playwright/index.mjs"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.mts",
			"import": "./dist/plugins/index.mjs"
		},
		"./react": {
			"types": "./dist/react/index.d.mts",
			"import": "./dist/react/index.mjs"
		},
		"./shapes": {
			"types": "./dist/shapes/index.d.mts",
			"import": "./dist/shapes/index.mjs"
		},
		"./vitest": {
			"types": "./dist/vitest/index.d.mts",
			"import": "./dist/vitest/index.mjs"
		}
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@mysten/codegen": "catalog:",
		"@mysten/sui": "catalog:",
		"ink": "^7.0.0",
		"react": "catalog:"
	},
	"devDependencies": {
		"@mysten-incubation/dev-wallet": "workspace:*",
		"@mysten-incubation/devstack-wallet-panels": "workspace:*",
		"@mysten/dapp-kit-core": "catalog:",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"tsdown": "^0.21.10",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@mysten-incubation/dev-wallet": "workspace:*",
		"@mysten-incubation/devstack-wallet-panels": "workspace:*",
		"@mysten/dapp-kit-core": "catalog:",
		"@playwright/test": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependenciesMeta": {
		"@mysten-incubation/dev-wallet": {
			"optional": true
		},
		"@mysten-incubation/devstack-wallet-panels": {
			"optional": true
		},
		"@mysten/dapp-kit-core": {
			"optional": true
		},
		"@playwright/test": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	}
}
