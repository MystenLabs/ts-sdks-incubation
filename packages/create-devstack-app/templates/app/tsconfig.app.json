{
	"extends": "@mysten-incubation/tsconfig/react.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"types": ["vite/client"],
		"paths": {
			"@generated/*": ["./src/generated/*"]
		}
	},
	"include": ["src/**/*", "deployments/**/*"],
	"exclude": ["dist", "node_modules", "tests"]
}
