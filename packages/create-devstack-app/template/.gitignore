# Node.js
node_modules/
*.log
.tsbuildinfo
*.tsbuildinfo

# App build output
dist/
coverage/

# Vite
*.local

# Env
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.idea/
.vscode/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Devstack runtime state (per-stack manifest + keys + ports)
.devstack/active
.devstack/stacks/
.devstack/.generated/
.devstack/manifests/
.devstack/snapshots/

# Codegen output (regenerated by `devstack codegen` / `devstack apply`).
# Contains dev-only bearer tokens via the burner-wallet adapter manifest
# baked into dapp-kit-config.ts, so kept out of source control.
src/generated/

# Move build artifacts (generated by `sui move summary` during codegen)
move/**/build/
move/**/package_summaries/
*.mv
