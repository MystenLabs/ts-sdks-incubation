{
	"name": "@mysten-incubation/_template",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"devstack:apply": "DEVSTACK_APP=_template devstack apply",
		"apply": "pnpm run devstack:apply",
		"dev": "DEVSTACK_APP=_template devstack up",
		"build": "pnpm run devstack:apply && DEVSTACK_APP=_template tsc -b && DEVSTACK_APP=_template vite build",
		"preview": "vite preview",
		"typecheck": "pnpm run devstack:apply && tsc -b --noEmit",
		"test": "pnpm run typecheck && vitest run",
		"test:e2e": "DEVSTACK_APP=_template DEVSTACK_STACK=test playwright test",
		"clean": "rm -rf dist .turbo node_modules/.tmp"
	},
	"dependencies": {
		"@mysten-incubation/dev-wallet": "^0.3.0",
		"@mysten-incubation/devstack": "^0.1.1",
		"@mysten/dapp-kit-core": "^1.3.0",
		"@mysten/dapp-kit-react": "^2.0.1",
		"@mysten/deepbook-v3": "^1.3.3",
		"@mysten/seal": "^1.1.1",
		"@mysten/sui": "^2.17.0",
		"@mysten/wallet-standard": "^0.20.1",
		"@mysten/walrus": "^1.1.7",
		"@mysten/walrus-wasm": "^0.2.0",
		"@tanstack/react-query": "^5.100.0",
		"effect": "4.0.0-beta.65",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@mysten-incubation/tsconfig": "^0.0.1",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^24.12.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vitest": "^4.1.6"
	},
	"engines": {
		"node": ">=24"
	}
}
