{
	"name": "@mysten-incubation/create-devstack-app",
	"version": "0.2.0",
	"description": "Scaffold a new devstack-backed Sui app. Run via `pnpm create @mysten-incubation/devstack-app <name>`.",
	"keywords": [
		"sui",
		"devstack",
		"scaffold",
		"create"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/MystenLabs/ts-sdks-incubation",
		"directory": "packages/create-devstack-app"
	},
	"homepage": "https://github.com/MystenLabs/ts-sdks-incubation/tree/main/packages/create-devstack-app#readme",
	"bugs": {
		"url": "https://github.com/MystenLabs/ts-sdks-incubation/issues"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"bin": {
		"create-devstack-app": "./dist/bin.mjs"
	},
	"files": [
		"dist",
		"templates",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.5.1",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@mysten-incubation/dev-wallet": "workspace:^",
		"@mysten-incubation/devstack": "workspace:^",
		"@mysten-incubation/tsconfig": "workspace:^",
		"@types/node": "catalog:",
		"tsdown": "^0.22.2",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
