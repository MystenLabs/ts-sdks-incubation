# Console MCP Server Configuration
# Get these values from https://testnet.console.walrus.xyz/ → Integrations

# Required: Your Console API key (starts with hbr_)
CONSOLE_API_KEY=hbr_your_api_key_here

# Required for create_bucket + upload + download (private Seal-encrypted buckets)
# This is the `suiprivkey1...` service private key shown once when you create the API key.
CONSOLE_SERVICE_PRIVATE_KEY=suiprivkey1_your_service_private_key_here

# Optional — management (Key-Admin) credential for headless minting via generate_api_key.
# Easiest path: `npx -y @mysten-incubation/walrus-console-mcp config` and choose "Management key" — it saves both
# halves to ~/.config/walrus-console-mcp/config.json (0600). These env vars still override it.
# Load these ONLY on the provisioning host, never alongside a worker's key.
# CONSOLE_ADMIN_KEY is the hbradm_... bearer; CONSOLE_ADMIN_SERVICE_PRIVATE_KEY is its
# suiprivkey1... signer seed. A working key alone cannot mint.
# CONSOLE_ADMIN_KEY=hbradm_your_key_admin_credential_here
# CONSOLE_ADMIN_SERVICE_PRIVATE_KEY=suiprivkey1_your_admin_signer_here

# Optional: Override the API base (defaults to testnet).
# Must be https to a *.walrus.xyz host, or http(s) to localhost.
# CONSOLE_API_BASE_URL=https://api.testnet.console.walrus.xyz

# Optional: allowed directories for upload_file / download_file when your MCP
# client does not advertise filesystem roots (e.g. Claude Desktop). PATH-style
# list separated by ':' (';' on Windows); '~' is expanded. Without roots AND
# without this, file tools fail closed.
# CONSOLE_MCP_ALLOWED_DIRS=~/Documents:~/Downloads
