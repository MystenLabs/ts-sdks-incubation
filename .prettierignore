# ignore everything by default
# /*
# Enable prettier for packages
!/packages

# ignore generated files
npm-debug.log*
package-lock.json
yarn-debug.log*
.claude
build/
coverage/
dist/
out/
generated/
playwright-report/
CHANGELOG.md
package.json
pnpm-lock.yaml
packages/*/docs/
packages/docs/.source/

# Devstack runtime state and codegen output
**/.devstack/
**/src/generated/sui/
**/move/**/build/
**/move/**/package_summaries/

# Vendored repositories (read-only reference material for coding agents)
repos/

# tsc -b emits sibling .js/.d.ts in examples/ — not source
examples/*/*.config.js
examples/*/*.config.d.ts
examples/*/*Plugin.js
examples/*/*Plugin.d.ts
